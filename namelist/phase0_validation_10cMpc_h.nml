! Phase 0 validation: standard LCDM hydro+gravity in a 10 h^-1 cMpc box.
! levelmax=14 gives 10/(h*2^14) = 0.89 kpc for h=0.684 at z=0.
! The legacy table is only for RAMSES startup compatibility.  Phase 0
! uses its embedded backend unless PHASE0_YIELD_TABLE is set in the shell.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nremap=10
nsubcycle=1,2,2,2,2,2
ncontrol=1
nstepmax=100000
use_fftw=.true.
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/Phase0_validation/ic_10cMpc_h/ic_lcdm_10cMpc_h/level_009'
/

&COSMO_PARAMS
omega_b=0.04809172052939365
/

&AMR_PARAMS
levelmin=9
levelmax=14
ngridtot=100000000
nparttot=300000000
ngridmax_auto=.true.
npartmax_auto=.true.
nexpand=1
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
scheme='muscl'
riemann='hllc'
pressure_fix=.true.
/

&PHYSICS_PARAMS
cooling=.true.
metal=.true.
haardt_madau=.true.
self_shielding=.true.
t_star=8.0
n_star=0.1
eps_star=0.02
T2_star=1.d4
T2thres_SF=1.d4
yieldtablefilename='/gpfs/kjhan/Run_JWST/opt_run/yield_table.asc'
/

&OUTPUT_PARAMS
noutput=21
aout=0.02,0.03,0.04,0.05,0.063,0.077,0.091,0.111,0.143,0.2,0.25,0.333,0.4,0.5,0.588,0.667,0.769,0.833,0.909,0.952,1.0
match_aout=.true.
foutput=1000000
fbackup=1000000
/

&REFINE_PARAMS
m_refine=9*8.
interpol_var=1
interpol_type=0
/
