+/* Root is computed from the actual solver energy/species, not the bounded
+ * temperature used for off-domain Newton trials in f(). */
+static int snrt_temperature_root(realtype t,N_Vector y,realtype *gout,void *ptr)
+{
+  (void)t;
+  struct UserData *d=ptr;
+  double sum=0;int i=0;
+  for(int s=0;s<d->myGlobalVars->totalNumberOfSpecies;s++)
+    if(d->species[s].include_species==1)sum+=NV_Ith_S(y,i++);
+    else sum+=d->myGasVars->abundances[s];
+  if(!isfinite(sum) || sum<=0)return -1;
+  gout[0]=NV_Ith_S(y,d->network_size)/(1.5*BOLTZMANNCGS*d->myGasVars->nH_tot*sum)
+    -snrt_chimes_thermal_ceiling(d->myGlobalVars);
+  return isfinite(gout[0])?0:-1;
+}
+
+static void snrt_install_temperature_root(void *mem,const struct globalVariables *c,double end)
+{
+  if(snrt_chimes_thermal_ceiling && snrt_chimes_thermal_ceiling(c)>0) {
+    int direction=1;
+    CVodeRootInit(mem,1,snrt_temperature_root);
+    CVodeSetRootDirection(mem,&direction);
+    /* Do not report an internal overshoot event beyond the requested step. */
+    CVodeSetStopTime(mem,end);
+  }
+}
