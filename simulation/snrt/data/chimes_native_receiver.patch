 ChimesFloat calculate_total_cooling_rate(struct gasVariables *myGasVars, const struct globalVariables *myGlobalVars, struct UserData data, int mode) 
 {
+  if(snrt_chimes_molecular_coefficients && myGlobalVars->StaticMolCooling) {
+    /* The native RT receiver owns continuum attenuation. Molecular line
+     * escape still needs the local, evolving columns, independently of
+     * cellSelfShieldingOn (which RT forbids). Never interpret divVel==0
+     * as an infinite Sobolev column in a finite cell. */
+    ChimesFloat column=myGasVars->cell_size*myGasVars->nH_tot;
+    data.CO_column=myGasVars->abundances[sp_CO]*column;
+    data.H2O_column=myGasVars->abundances[sp_H2O]*column;
+    data.OH_column=myGasVars->abundances[sp_OH]*column;
+  }
   int i, xHII_index, Psi_index, T_index, T_mol_index, N_CO_rot_index, N_CO_vib_index; 
   int N_H2O_rot_index, N_H2O_vib_index, T_H2O_index; 
   ChimesFloat x_elec, log_xHII, d_xHII, log_Psi, dPsi, log_T, dT, G0; 
