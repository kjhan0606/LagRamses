{
  "schema": "phase0_stellar_yield_table_v1",
  "format": {
    "name": "canonical_phase0_ascii",
    "row_fields": 32,
    "field_order": [
      "channel",
      "initial_mass_msun_per_star",
      "birth_metallicity_mass_fraction",
      "age_yr",
      "returned_mass_msun_per_star",
      "remnant_mass_msun_per_star",
      "energy_erg_per_star",
      "momentum_x_g_cm_s_per_star",
      "momentum_y_g_cm_s_per_star",
      "momentum_z_g_cm_s_per_star",
      "ejecta_H_msun_per_star",
      "ejecta_He_msun_per_star",
      "ejecta_C_msun_per_star",
      "ejecta_N_msun_per_star",
      "ejecta_O_msun_per_star",
      "ejecta_Ne_msun_per_star",
      "ejecta_Mg_msun_per_star",
      "ejecta_Si_msun_per_star",
      "ejecta_S_msun_per_star",
      "ejecta_Ca_msun_per_star",
      "ejecta_Fe_msun_per_star",
      "net_H_msun_per_star",
      "net_He_msun_per_star",
      "net_C_msun_per_star",
      "net_N_msun_per_star",
      "net_O_msun_per_star",
      "net_Ne_msun_per_star",
      "net_Mg_msun_per_star",
      "net_Si_msun_per_star",
      "net_S_msun_per_star",
      "net_Ca_msun_per_star",
      "net_Fe_msun_per_star"
    ],
    "elements": ["H", "He", "C", "N", "O", "Ne", "Mg", "Si", "S", "Ca", "Fe"],
    "tracked_ejecta_mass_relation": "0 <= sum(ejecta_H..Fe) <= returned_mass_msun_per_star",
    "untracked_ejecta_mass_definition": "returned_mass_msun_per_star - sum(ejecta_H..Fe)",
    "untracked_ejecta_policy": "returned_mass_minus_sum_tracked_ejecta_deposited_as_generic_metals",
    "untracked_ejecta_individual_element_policy": "never assign the residual to an individual tracked element",
    "momentum_vector_semantics": "cumulative net directed source-frame momentum; an unresolved isotropic source is exactly [0,0,0]",
    "advective_momentum_semantics": "returned-mass bulk momentum is added at runtime as returned_mass times particle velocity and is not stored in the source-frame vector",
    "radial_momentum_semantics": "scalar outward shell momentum requires a separate deposition/subgrid contract and must never be placed in an arbitrary canonical vector component",
    "cumulative_fields": ["returned_mass_msun_per_star", "remnant_mass_msun_per_star", "energy_erg_per_star", "ejecta_*_msun_per_star"],
    "net_yields_are_diagnostic_only": true
  },
  "runtime": {
    "required_channels": [1, 2, 3],
    "optional_channels": [4, 5],
    "channel_names": {
      "1": "wind",
      "2": "AGB",
      "3": "SNII",
      "4": "SNIa",
      "5": "PISN"
    },
    "terminal_remnant_owner": {
      "1": false,
      "2": true,
      "3": true,
      "4": false,
      "5": false
    },
    "channel_mass_ranges_msun": {
      "1": [0.8, 120.0],
      "2": [1.0, 8.0],
      "3": [8.0, 40.0],
      "4": [3.0, 8.0],
      "5": [140.0, 260.0]
    },
    "terminal_fate_policy": "review_only_unresolved",
    "terminal_fate_resolver": "per_source_node_fate_lookup_v1",
    "terminal_fate_resolution_notes": "The 40--120 Msun interval is model-dependent and is not a universal direct-collapse bin. PISN is complete disruption and therefore does not own a terminal remnant.",
    "required_age_range_yr": [0.0, 13800000000.0],
    "required_birth_metallicity_range_mass_fraction": null
  },
  "production_gate": {
    "require_complete_cartesian_grid": true,
    "require_age_zero": true,
    "require_zero_age_release": true,
    "require_monotonic_cumulative_fields": true,
    "require_approved_required_channels": true,
    "require_provenance_sidecar": true,
    "required_provenance_fields": [
      "approval_id",
      "citation",
      "source_version",
      "source_sha256",
      "license_status",
      "provenance_status",
      "units",
      "IMF",
      "population_model",
      "channel_boundaries",
      "metallicity_definition",
      "solar_abundance_set",
      "remnant_model",
      "untracked_ejecta_policy",
      "conversion_code_sha256"
    ],
    "accepted_license_statuses": ["verified", "approved"],
    "accepted_provenance_statuses": ["recorded", "approved"],
    "relative_tolerance": 1.0e-8,
    "absolute_tolerance": 1.0e-12
  },
  "approval": {
    "channel_status": {
      "1": "pending_physics_approval",
      "2": "pending_physics_approval",
      "3": "pending_physics_approval",
      "4": "not_implemented",
      "5": "not_implemented"
    }
  }
}
