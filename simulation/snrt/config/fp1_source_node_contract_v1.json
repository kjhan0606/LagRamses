{
  "schema": "snrt-fp1-source-node-contract",
  "schema_version": 1,
  "gate": "F-P1H-B",
  "status": "contract_only_no_physical_nodes",
  "purpose": "Preserve every physical source-node coordinate and feedback semantic outside the fixed 32-field numerical payload without inventing missing values.",
  "node_storage": {
    "mode": "immutable_sidecar_with_canonical_row_mapping",
    "canonical_row_field_count": 32,
    "source_node_id_required_for_every_canonical_row": true,
    "source_node_mapping_sha256_required": true,
    "silent_axis_drop_allowed": false
  },
  "required_fields": {
    "identity_and_rights": [
      "source_node_id",
      "source_id",
      "source_version",
      "source_sha256",
      "article_doi",
      "data_doi",
      "archive_url",
      "package_fingerprint",
      "retrieval_date",
      "license_id",
      "research_use_status",
      "redistribution_status",
      "conversion_code_sha256",
      "converter_version",
      "approval_id"
    ],
    "coordinates": [
      "zams_mass_msun",
      "mass_cell_msun",
      "birth_metallicity_value",
      "birth_metallicity_definition",
      "solar_abundance_set",
      "initial_rotation_value_or_declared_marginalization",
      "binary_state_or_declared_population_marginalization",
      "period_mass_ratio_distribution_or_null",
      "mass_transfer_prescription_or_null",
      "common_envelope_prescription_or_null",
      "engine_or_branch_id",
      "mass_cell_assignment_rule",
      "lifetime_source_id",
      "pair_instability_criterion_id"
    ],
    "pre_sn_structure_and_fate": [
      "presn_total_mass_msun",
      "he_core_mass_msun",
      "co_core_mass_msun",
      "fe_core_mass_msun",
      "compactness_xi_2_5_and_definition",
      "m4_mu4_if_classifier_uses_them",
      "fate_classifier_id",
      "classifier_version",
      "engine_calibration_id",
      "threshold_provenance",
      "outcome"
    ],
    "timing_and_wind": [
      "lifetime_yr_or_declared_no_terminal_horizon",
      "lifetime_definition",
      "age_zero_anchor",
      "wind_release_age_yr",
      "cumulative_wind_mass_msun",
      "cumulative_wind_tracked_elements_msun",
      "cumulative_wind_untracked_msun",
      "terminal_lumping_approximation_or_null"
    ],
    "terminal_ejecta_and_remnant": [
      "terminal_ejecta_mass_msun",
      "terminal_ejecta_tracked_elements_msun",
      "terminal_untracked_msun",
      "terminal_component_reference",
      "is_zero_because_direct_collapse",
      "fallback_mass_msun",
      "baryonic_remnant_mass_msun",
      "gravitational_remnant_mass_msun_or_null_with_convention",
      "remnant_type",
      "terminal_remnant_owner_channel"
    ],
    "pair_instability": [
      "pair_instability_criterion_input",
      "ppisn_pulse_history_reference_or_null",
      "pisn_complete_disruption_confirmation",
      "final_remnant_mass_msun_or_null"
    ],
    "decay": [
      "decay_projection_id",
      "projection_horizon_yr",
      "raw_isotope_count",
      "isotope_completeness",
      "cross_segment_duplicate_resolution",
      "decay_data_id_and_sha256",
      "missing_nuclide_policy",
      "decay_closure_residual_msun",
      "rest_mass_loss_treatment"
    ],
    "energy_momentum_and_deposition": [
      "energy_kind",
      "final_kinetic_energy_erg",
      "diagnostic_energy_erg",
      "injected_energy_erg_or_null",
      "injected_energy_mapping_id_or_null",
      "energy_is_outcome_flag",
      "source_frame_vector_momentum_g_cm_s",
      "canonical_scalar_launch_momentum_g_cm_s_or_null",
      "momentum_convention",
      "deposition_contract_id_or_null",
      "coupling_efficiency_model_or_null",
      "advective_momentum_policy",
      "untracked_residual_policy"
    ]
  },
  "null_and_zero_semantics": {
    "missing_value_encoding": null,
    "missing_value_must_not_be_rewritten_as_zero": true,
    "physical_zero_requires_source_evidence_and_reason": true,
    "failed_or_direct_collapse_node_must_be_present": true,
    "direct_collapse_terminal_ejecta_must_be_explicit_zero": true,
    "direct_collapse_remnant_must_be_non_null": true,
    "absent_node_interpolation_forbidden": true
  },
  "axis_reduction_policy": {
    "silent_reduction_allowed": false,
    "allowed_modes": [
      "none",
      "explicit_frozen_axis",
      "approved_population_marginalization"
    ],
    "required_for_frozen_axis": [
      "axis",
      "fixed_value",
      "scientific_justification",
      "approval_id"
    ],
    "required_for_population_marginalization": [
      "axis",
      "distribution_id",
      "distribution_parameters",
      "normalized_weights",
      "source_hull",
      "approval_id"
    ]
  },
  "coverage_policy": {
    "mass_domain_msun": [40.0, 120.0],
    "mass_cells_must_tile_domain_without_gap_or_overlap": true,
    "edge_convention": "half_open_left_closed_right_last",
    "out_of_full_source_hull_policy": "unresolved_and_block",
    "endpoint_clamping_allowed": false,
    "mass_outcome_interpolation_allowed": false,
    "cross_source_interpolation_allowed": false,
    "cross_engine_interpolation_allowed": false,
    "only_allowed_continuous_interpolation": "single_node_monotone_cumulative_wind_age_axis"
  },
  "conversion_policy": {
    "lifetime_inference_from_integrated_yields_allowed": false,
    "momentum_inference_from_energy_allowed": false,
    "injected_energy_inference_from_asymptotic_or_diagnostic_energy_allowed": false,
    "cross_branch_wind_merge_allowed": false,
    "source_node_contract_sha256_required": true,
    "source_node_mapping_sha256_required": true,
    "axis_reduction_policy_required": true,
    "energy_semantics_required": true,
    "momentum_deposition_contract_required": true
  },
  "record_validation": {
    "allowed_outcomes": [
      "successful_terminal",
      "failed_explosion",
      "direct_collapse",
      "fallback_terminal",
      "ppisn",
      "pisn_complete_disruption",
      "not_terminal_within_horizon"
    ],
    "tracked_element_count": 11,
    "source_frame_vector_length": 3,
    "direct_collapse_requires_zero_terminal_ejecta": true,
    "direct_collapse_requires_baryonic_remnant": true,
    "direct_collapse_requires_terminal_component_reference": true,
    "pisn_requires_zero_final_remnant": true,
    "cumulative_wind_age_and_mass_must_be_monotone": true,
    "failed_or_direct_collapse_requires_explicit_wind_history": true,
    "terminal_ejecta_components_must_close": true,
    "cumulative_wind_components_must_close": true,
    "mass_cells_must_not_overlap_within_resolver_branch": true,
    "approved_mass_cells_must_tile_each_resolver_branch": true,
    "typed_rights_and_identifier_fields_required": true,
    "approved_nodes_require_rights_and_provenance": true,
    "birth_metallicity_must_be_finite": true,
    "binary_state_or_marginalization_must_be_explicit": true,
    "half_open_cell_membership_must_be_enforced": true,
    "approved_package_fingerprint_must_be_sha256": true,
    "approved_rights_statuses_must_be_allowed": true,
    "conditional_binary_axes_must_be_typed": true
  },
  "physical_nodes": [],
  "approval": {
    "physical_nodes_present": false,
    "canonical_conversion_allowed": false,
    "runtime_deposition_allowed": false,
    "production_ready": false,
    "approval_id": null
  }
}
