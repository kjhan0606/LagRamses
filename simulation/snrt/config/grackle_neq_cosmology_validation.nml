&RUN_PARAMS
 hydro=.true., pic=.false., poisson=.false., cosmo=.true.
 nstepmax=6, ncontrol=1
/
&COSMO_PARAMS
 omega_b=.048d0, omega_m=.30d0, omega_l=.70d0, h0=.70d0
/
&AMR_PARAMS
 levelmin=3, levelmax=3, ngridmax=10000, npartmax=100, boxlen=1d0
/
&OUTPUT_PARAMS
 outformat='hdf5', informat='hdf5'
 noutput=1, tout=1d100, aout=1.1d0, foutput=1, fbackup=1000000
/
&HYDRO_PARAMS
 gamma=1.6666666666666667d0, courant_factor=.5d0
 scheme='muscl', riemann='hllc'
/
&INIT_PARAMS
 aexp_ini=.1d0
 nregion=1, region_type='square'
 x_center=.5d0, y_center=.5d0, z_center=.5d0
 length_x=1d0, length_y=1d0, length_z=1d0
 d_region=1d0, p_region=100d0
/
&PHYSICS_PARAMS
 cooling=.true., metal=.true., cooling_method='grackle_neq'
 neq_chem=.false., dust_mass_enabled=.false., haardt_madau=.true.
 grackle_neq_data_file='/home/kjhan/BACKUP/Eunha.A1/Prerequisites/Cooling_Grackle/input/CloudyData_UVB=HM2012.h5'
 grackle_neq_h2_shielding=0
 omega_b=.048d0
 units_density=1.6726219d-24, units_length=3.0856776d21, units_time=3.15576d13
/
&STELLAR_ENRICHMENT_PARAMS
 feedback_mode='legacy', use_wind=.false., use_agb=.false.
 use_snii=.false., use_snia=.false., use_pisn=.false.
/
