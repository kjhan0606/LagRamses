&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
sink=.true.
sinkprops=.true. ! Pre-feedback sink source ledger for SNRT RT post-processing
nrestart=5
nremap=5
nsubcycle=1,1,2
ncontrol=1
nstepmax=203
ordering='ksection'
memory_balance=.true.
/

&OUTPUT_PARAMS
noutput=20
aout=0.05,0.10,0.15,0.20,0.25,0.30,0.35,0.40,0.45,0.50,
     0.55,0.60,0.65,0.70,0.75,0.80,0.85,0.90,0.95,1.00
foutput=200
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/Hydro/CUBE_HR5/code_cube/test_medium/ic_lv9'
/

&AMR_PARAMS
levelmin=9
levelmax=17
nexpand=1
ngridtot=88000000
nparttot=200000000
/

&LIGHTCONE_PARAMS
/

&REFINE_PARAMS
m_refine=9*8.,
ivar_refine=0
interpol_var=1
interpol_type=0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
slope_type=1
/

&POISSON_PARAMS
/

&PHYSICS_PARAMS
cooling=.true.
haardt_madau=.true.
metal=.true.
z_ave=1.0e-3
eps_star=0.02
del_star=55.
n_star=0.1d0
m_star=0.2
T2_star=750
g_star=1.66667
f_w=3.
f_ek=0.3
eps_sn2=2.
eps_sn1=2.
tol=1.d-3
yieldtablefilename='yield_table.asc'
z_reion=10.
omega_b=0.04
delayed_cooling=.true.
Mseed=1d4
sink_AGN=.true.
bondi=.true.
drag=.true.
rAGN=4.d0
X_floor=1d-2
eAGN_K=1d0
eAGN_T=1.5d-1
TAGN=0.0
r_gal=50d0
T2maxAGN=1d8
boost_acc=2d0
boost_drag=2d0
vrel_merge=.true.
rmerge=4d0
spin_bh=.true.
mad_jet=.true.
/
