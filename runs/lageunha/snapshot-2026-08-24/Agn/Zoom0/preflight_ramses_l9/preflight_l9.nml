&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
nrestart=0
nremap=0
nstepmax=2
nsubcycle=1,1,3*2
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../preflight_music/ic_preflight_l9/level_008'
initfile(2)='../preflight_music/ic_preflight_l9/level_009'
/

&AMR_PARAMS
levelmin=8
levelmax=12
nexpand=1,1,3*1
ngridtot=40000000
nparttot=30000000
/

&REFINE_PARAMS
m_refine=5*8.
ivar_refine=0
mass_cut_refine=1.49012d-8
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
/
