initfile(1)='../parent/ic_parent_lv8/level_008'
/

&AMR_PARAMS
levelmin=8
levelmax=12
nexpand=1,1,1,1,1
ngridtot=60000000
nparttot=24000000
/

&REFINE_PARAMS
