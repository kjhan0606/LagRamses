&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
nrestart=0
nremap=0
nsubcycle=1,1,2,2,2
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
