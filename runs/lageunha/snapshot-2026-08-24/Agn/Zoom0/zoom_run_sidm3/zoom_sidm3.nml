&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.true.
nrestart=8
nremap=0
nsubcycle=1,1,9*2
ncontrol=1
ordering='hilbert'
memory_balance=.false.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=7
aout=0.00990099,0.10000,0.20000,0.33333,0.50000,0.66667,1.00000
foutput=500
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../zoom_l11/ic_zoom_l11/level_008'
initfile(2)='../zoom_l11/ic_zoom_l11/level_009'
initfile(3)='../zoom_l11/ic_zoom_l11/level_010'
initfile(4)='../zoom_l11/ic_zoom_l11/level_011'
/

&AMR_PARAMS
levelmin=8
levelmax=18
nexpand=3,3,9*1
ngridtot=240000000
nparttot=200000000
/

&REFINE_PARAMS
m_refine=11*8.
ivar_refine=0
mass_cut_refine=2.3283064365d-10
interpol_var=1
interpol_type=0
q_refine_holdback=.true.
/

&POISSON_PARAMS
/

&SIDM_PARAMS
sidm_cross_section=3.0
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/
