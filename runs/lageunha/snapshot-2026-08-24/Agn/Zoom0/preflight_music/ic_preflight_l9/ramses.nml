&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=1
nsubcycle=1,1,1,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='./ic_preflight_l9/level_008'
initfile(2)='./ic_preflight_l9/level_009'
/

&AMR_PARAMS
levelmin=8
levelmax=17
nexpand=1,1
ngridtot=2000000
nparttot=3000000
/

&REFINE_PARAMS
m_refine=10*8.,
ivar_refine=0
mass_cut_refine=1.49012e-08
interpol_var=1
interpol_type=0
/

