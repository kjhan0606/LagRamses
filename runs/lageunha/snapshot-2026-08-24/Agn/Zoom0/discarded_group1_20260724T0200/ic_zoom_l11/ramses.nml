&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nremap=1
nsubcycle=1,1,1,1,1,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='./ic_zoom_l11/level_008'
initfile(2)='./ic_zoom_l11/level_009'
initfile(3)='./ic_zoom_l11/level_010'
initfile(4)='./ic_zoom_l11/level_011'
/

&AMR_PARAMS
levelmin=8
levelmax=19
nexpand=3,3,1,1
ngridtot=2000000
nparttot=3000000
/

&REFINE_PARAMS
m_refine=12*8.,
ivar_refine=0
mass_cut_refine=2.32831e-10
interpol_var=1
interpol_type=0
/

