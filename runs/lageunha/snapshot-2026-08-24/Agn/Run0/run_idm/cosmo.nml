courant_factor=0.8
scheme='muscl'
slope_type=1
/

&POISSON_PARAMS
/

&PHYSICS_PARAMS
cooling=.true.
haardt_madau=.true.
metal=.true.
z_ave=1.0e-3
eps_star=0.02
del_star=55.
n_star=0.1d0
m_star=0.2
T2_star=750
g_star=1.66667
f_w=3.
f_ek=0.3
eps_sn2=2.
eps_sn1=2.
tol=1.d-3
z_reion=10.
omega_b=0.04
delayed_cooling=.true.
Mseed=1d4
sink_AGN=.true.
bondi=.true.
drag=.true.
rAGN=4.d0
X_floor=1d-2
eAGN_K=1d0
eAGN_T=1.5d-1
TAGN=0.0
r_gal=50d0
