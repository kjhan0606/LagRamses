&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
sink=.true.
sidm=.true.
nrestart=15
nremap=0
nsubcycle=1,1,2
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=41
aout=0.07943,0.08913,0.10000,0.11220,0.12589,0.13335,0.14125,0.14962,
     0.15849,0.16788,0.17783,0.18836,0.19953,0.21135,0.22387,0.23714,
