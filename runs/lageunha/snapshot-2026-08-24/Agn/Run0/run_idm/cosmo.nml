     0.39811,0.42170,0.44668,0.47315,0.50119,0.53088,0.56234,0.59566,
     0.63096,0.66834,0.70795,0.74989,0.79433,0.84140,0.89125,0.94406,
     1.00000
foutput=500
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='../ic_lv10/level_010'
/

&AMR_PARAMS
levelmin=10
levelmax=17
nexpand=1
ngridtot=1800000000
nparttot=2500000000
/

&LIGHTCONE_PARAMS
/

&REFINE_PARAMS
