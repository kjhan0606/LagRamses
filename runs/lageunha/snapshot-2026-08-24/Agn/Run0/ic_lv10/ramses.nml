&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nremap=1
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='./ic_lv10/level_010'
/

&AMR_PARAMS
levelmin=10
levelmax=18
nexpand=1
ngridtot=2000000
nparttot=3000000
/

&REFINE_PARAMS
m_refine=9*8.,
ivar_refine=6
var_cut_refine=0.01
mass_cut_refine=1.86265e-09
interpol_var=1
interpol_type=0
/

