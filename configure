#!/usr/bin/env python3
"""Generate an isolated lagRamses Makefile without editing any source file.

Examples:
  ./configure --build-dir ~/.astro/build/lagRamses
  make -C ~/.astro/build/lagRamses/bin

The supported auto profile selects Intel MPI/ifx (or mpiifort). An explicitly
selected GNU profile generates GNU flags and probes MPI/OpenMP, but is not a
claim that this fork's full scientific build has been validated with GNU.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile


def make_value(value):
    return str(value).replace("$", "$$").replace("#", "\\#")


def compiler_settings(args):
    family = args.compiler
    candidates = ("mpiifx", "mpiifort") if family in ("auto", "intel") else ("mpifort", "mpif90")
    compiler = args.fc or next((shutil.which(name) for name in candidates if shutil.which(name)), None)
    if compiler is None:
        if args.no_probe:
            compiler = candidates[0]
        else:
            raise ValueError("Intel MPI/ifx was not found. Load the site compiler/MPI module; use --compiler gnu only for an explicit experimental GNU configuration.")
    if family == "auto":
        # Auto never silently changes the fork's supported compiler family.
        family = "intel"
    executable = shutil.which(compiler) or compiler
    flags = ["-qopenmp"] if family == "intel" else ["-fopenmp", "-ffree-line-length-none", "-fallow-argument-mismatch"]
    version = "not probed"
    if not args.no_probe:
        version = subprocess.check_output([executable, "--version"], text=True, stderr=subprocess.STDOUT).strip()[:4096]
        with tempfile.TemporaryDirectory(prefix="lagramses-configure-") as name:
            folder = Path(name)
            code = folder / "probe.f90"
            code.write_text("program probe\nuse mpi\nuse omp_lib\nimplicit none\ninteger :: ierr\ncall MPI_Init(ierr)\nprint *, omp_get_max_threads()\ncall MPI_Finalize(ierr)\nend program probe\n")
            subprocess.run([executable, *flags, str(code), "-o", str(folder / "probe")], check=True, capture_output=True, text=True)
    return family, executable, flags, version


def configure(args):
    source = Path(__file__).resolve().parent
    upstream = source / "bin/Makefile"
    if not upstream.is_file() or not (source / "amr").is_dir():
        raise ValueError("Keep configure at the root of the lagRamses checkout")
    destination = Path(args.build_dir or (source / ".astrafek/build")).expanduser().resolve()
    if destination == source or destination in source.parents:
        raise ValueError("Choose a separate build directory, not the source root or its parent")
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]{0,63}", args.executable_prefix):
        raise ValueError("Executable prefix must contain only letters, digits, underscore or hyphen")
    marker = destination / "lagramses-configure.json"
    if destination.exists() and any(destination.iterdir()):
        if not marker.is_file() or json.loads(marker.read_text()).get("source_dir") != str(source):
            raise ValueError("Nonempty build directory is not owned by this configure run; choose another directory")
    family, compiler, flags, version = compiler_settings(args)
    original = upstream.read_text()
    if family == "gnu":
        original = original.replace("-fpp", "-cpp").replace("-qopenmp", "-fopenmp")
        original = original.replace("-check bounds -traceback", "-fcheck=bounds -fbacktrace")
    original = original.replace("\tmpiifx $(FFLAGS)", "\t$(F90) $(FFLAGS)")
    revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip()
    dirty = bool(subprocess.check_output(["git", "status", "--porcelain", "--untracked-files=no"], cwd=source, text=True).strip())
    prelude = "# Generated by lagRamses/configure. The upstream Makefile is unchanged.\n.DEFAULT_GOAL := ramses\n.NOTPARALLEL:\n"
    prelude += "override F90 := " + make_value(shlex.join([compiler, flags[0]])) + "\n"
    prelude += "override EXEC := " + args.executable_prefix + "\n"
    prelude += "override USE_FFTW := 0\n"  # Supported iterative CPU Poisson; no optional FFTW dependency.
    prelude += "override GITBRANCH := configured\noverride GITREPO := local-configure\n"
    prelude += "override GITHASH := " + revision + ("-dirty" if dirty else "") + "\n"
    if family == "gnu":
        original += "\nFFLAGS += -ffree-line-length-none -fallow-argument-mismatch\n"
    folder = destination / "bin"
    # Check every existing path before creating files or replacing generated ones.
    for path in source.iterdir():
        if path.is_dir() and path.name not in (".git", ".astrafek", "bin") and path.resolve() != destination:
            link = destination / path.name
            if (link.exists() or link.is_symlink()) and (not link.is_symlink() or link.resolve() != path.resolve()):
                raise ValueError("Build directory contains a conflicting path: " + str(link))
    if folder.is_symlink():
        raise ValueError("Build bin directory must not be a symlink")
    folder.mkdir(parents=True, exist_ok=True)
    for path in source.iterdir():
        if path.is_dir() and path.name not in (".git", ".astrafek", "bin") and path.resolve() != destination:
            link = destination / path.name
            if not link.exists() and not link.is_symlink():
                link.symlink_to(path, target_is_directory=True)
    generated = prelude + original
    (folder / "Makefile").write_text(generated)
    report = dict(schema="lagramses-configure/1", source_dir=str(source), build_dir=str(destination), revision=revision,
                  tracked_source_dirty=dirty, compiler_family=family, compiler=compiler, compiler_version=version,
                  mpi_openmp_probe="skipped" if args.no_probe else "passed", full_solver_build_validated=False,
                  upstream_makefile_sha256=hashlib.sha256(upstream.read_bytes()).hexdigest(),
                  generated_makefile_sha256=hashlib.sha256(generated.encode()).hexdigest(),
                  executable=str(folder / (args.executable_prefix + "3d")),
                  profile="3D CPU MPI/OpenMP, NVAR=18, iterative Poisson, no optional CUDA/HDF5/RT/CHIMES activation")
    marker.write_text(json.dumps(report, indent=2) + "\n")
    print("Source (unchanged):", source)
    print("Generated Makefile:", folder / "Makefile")
    print("Compiler:", family, compiler, "| MPI/OpenMP probe:", report["mpi_openmp_probe"])
    if family == "gnu":
        print("GNU is an explicit experimental profile; the full solver build still needs validation.")
    print("Build with:", shlex.join(["make", "-C", str(folder), "-B"]))
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--build-dir", help="New isolated build root (default: <source>/.astrafek/build)")
    parser.add_argument("--compiler", choices=("auto", "intel", "gnu"), default="auto")
    parser.add_argument("--fc", help="MPI Fortran wrapper executable path; not a shell command")
    parser.add_argument("--executable-prefix", default="ramses_configured")
    parser.add_argument("--no-probe", action="store_true", help="Generate for review only; compiler availability/linking is NOT verified")
    args = parser.parse_args()
    try:
        configure(args)
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print("Configure stopped:", error, file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr[-4000:], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
