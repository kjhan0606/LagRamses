! [RESIZABLE] Phase 4 production-LB headroom growth candidate at 90688 grids/rank.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
use_pbh=.true.
nrestart=0
nremap=5
nsubcycle=1,1,2,2,2,2,2
ncontrol=1
lb_grid_headroom=0.85
/

&OUTPUT_PARAMS
noutput=2
aout=0.0588,0.0667
match_aout=.true.
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/home/kjhan/BACKUP/pbh_prod/icz256'
/

! omega_m, omega_l and h0 come from the grafic header; omega_b does not, and
! init_time falls back to a legacy 0.047 when it is unset. Set it explicitly so
! the run cannot silently disagree with the cosmology the paper quotes.
&COSMO_PARAMS
omega_b=0.0490
/

&AMR_PARAMS
levelmin=8
levelmax=10
ngridtot=2900000
nparttot=30000000
nexpand=1
/

&PBH_PARAMS
pbh_table_file='/home/kjhan/BACKUP/lagRamses-PBH/papers/pbh_working/tables/pbh_evap_table_ast_s1.dat'
pbh_fraction=0.05
pbh_energy_sink='uniform_heat'
pbh_mf_model='lognormal'
pbh_spin_model='schwarzschild'
pbh_epsdep_model='spectrum'
pbh_fheat_model='slatyer'
pbh_boost=1.0
/

&REFINE_PARAMS
m_refine=8.,8.,8.,8.,8.,8.
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
scheme='muscl'
riemann='hllc'
pressure_fix=.true.
beta_fix=0.5
/

&PHYSICS_PARAMS
cooling=.true.
/
