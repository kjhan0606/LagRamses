&RUN_PARAMS
hydro=.true.
pic=.false.
poisson=.false.
cosmo=.false.
ncontrol=1
nrestart=0
nremap=0
nstepmax=1
/

&AMR_PARAMS
levelmin=3
levelmax=5
ngridtot=20000
nexpand=0,0,0
boxlen=1.0
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center(1)=0.5
y_center(1)=0.5
z_center(1)=0.5
length_x(1)=2.0
length_y(1)=2.0
length_z(1)=2.0
d_region(1)=0.1
p_region(1)=1.0
/

&OUTPUT_PARAMS
noutput=1
tout=1.0d-4
tend=1.0d-4
/

&HYDRO_PARAMS
gamma=1.4
/

&REFINE_PARAMS
void_refine=.true.
void_refine_min_level=5
m_refine=-1.0,-1.0,-1.0
r_refine=0.5,-1.0,-1.0
x_refine=0.5,0.5,0.5
y_refine=0.5,0.5,0.5
z_refine=0.5,0.5,0.5
/
