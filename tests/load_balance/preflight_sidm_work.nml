&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.true.
nrestart=0
nremap=1
remap_thresh=0.05
nstepmax=1
nsubcycle=1,1,3*2
ncontrol=1
ordering='bisection'
memory_balance=.false.
work_weight_grid=80
work_weight_part=1
work_weight_sidm_pair=8
time_balance_alpha=0.3
lb_timing_interval=1
lb_timing_ema_alpha=0.25
lb_remap_min_interval=1
lb_remap_horizon=4
lb_remap_safety=1.2
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ic/level_008'
initfile(2)='ic/level_009'
/

&AMR_PARAMS
levelmin=8
levelmax=12
nexpand=1,1,3*1
ngridtot=40000000
nparttot=30000000
/

&REFINE_PARAMS
m_refine=5*8.
ivar_refine=0
mass_cut_refine=1.49012d-8
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&POISSON_PARAMS
/

&SIDM_PARAMS
sidm_cross_section=1.0
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/
