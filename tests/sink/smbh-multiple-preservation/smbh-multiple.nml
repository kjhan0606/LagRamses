&RUN_PARAMS
hydro=.true.
rt=.false.
nrestart=0
nstepmax=2
nremap=10
poisson=.true.
pic=.true.
use_fdm=.false.
sink=.true.
nsubcycle=1,2
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=0.5
y_center=0.5
z_center=0.5
length_x=10.0
length_y=10.0
length_z=10.0
exp_region=10.0
d_region=1d-2		   	  ! 1e-2 hydrogen atoms per cc
p_region=8.69869d-9       ! 1000 K
/

&AMR_PARAMS
levelmin=4
levelmax=4
ngridmax=12000
npartmax=50000
nexpand=4
boxlen=1. ! kpc
/

&OUTPUT_PARAMS
noutput=0
foutput=1
fbackup=1
tend=0.05  ! 0.05 Myr
/

&HYDRO_PARAMS
gamma=1.666666667
courant_factor=0.8
riemann='hllc'
slope_type=1
pressure_fix=.true.
beta_fix=0.5
/

&BOUNDARY_PARAMS
nboundary=0 ! periodic toy box; no six-face hydro ghost-boundary geometry
/

&POISSON_PARAMS
gravity_type=0
epsilon=1.0d-4
cg_levelmin=999
cic_levelmax=14
/

&SINK_PARAMS
smbh=.true.
agn=.false.
create_sinks=.false.
nsinkmax=8
mass_sink_seed=1.0d6 ! in M_sun
mass_smbh_seed=0
mass_sink_direct_force=1.0 ! in M_sun
accretion_scheme='bondi'
eddington_limit=.true.
acc_sink_boost=1.0 ! 1 is no boost
T2_min=0 ! always blast
AGN_fbk_frac_ener=0.0
AGN_fbk_frac_mom=0.0
AGN_fbk_mode_switch_threshold=0.0
nlevelmax_sink=4
/

&PHYSICS_PARAMS
cooling=.false.
metal=.false.
eps_star=0.0d0
t_star=0.0d0
units_density=1.66d-24 ! 1 H/cc
units_time=3.1556926d13 ! 1 Myr
units_length=0.308567758128200d22 ! 1 kpc
rmerge=1.0d0
vrel_merge=.false.
smbh_preserve_multiple=.true.
smbh_capture_ledger=.true.
smbh_capture_ledger_file='smbh_capture_ledger_v1.jsonl'
/

&STELLAR_ENRICHMENT_PARAMS
feedback_mode='legacy'
/
