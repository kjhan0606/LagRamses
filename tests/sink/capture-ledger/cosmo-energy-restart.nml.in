! Synthetic two-level cosmological DMO restart regression, not a production IC.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
clumpfind=.false.
radiation_transport='none'
nrestart=__NRESTART__
nstepmax=5
ncontrol=1
nremap=0
nsubcycle=1,1
ordering='hilbert'
aexp_step_limit=1.0d-4
use_fftw=.true.
/

&OUTPUT_PARAMS
noutput=1
aout=1.1
tout=1.0d100
foutput=1
fbackup=100000
informat='hdf5'
outformat='hdf5'
/

&COSMO_PARAMS
omega_m=0.3
omega_l=0.7
omega_b=0.05
h0=70.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='__IC_ROOT__/level_005'
initfile(2)='__IC_ROOT__/level_006'
/

&AMR_PARAMS
levelmin=5
levelmax=6
ngridtot=40000
nparttot=131072
nexpand=0
/

&REFINE_PARAMS
m_refine=8.0,8.0
ivar_refine=0
/

&POISSON_PARAMS
epsilon=1.0d-4
maxiter_fine=1000
abort_on_mg_nonconvergence=.true.
/

&STELLAR_ENRICHMENT_PARAMS
feedback_mode='legacy'
/
