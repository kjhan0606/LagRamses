! Uniform-gas 3-sink conservation diagnostic; not a calibrated galaxy model.
&RUN_PARAMS
cosmo=.false.
hydro=.true.
pic=.true.
poisson=.true.
sink=.true.
clumpfind=.false.
radiation_transport='none'
nrestart=0
nstepmax=2
nsubcycle=1,1
nremap=0
use_fftw=.true.
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
exp_region(1)=100.0
x_center=0.5
y_center=0.5
z_center=0.5
length_x=1.0
length_y=1.0
length_z=1.0
d_region=1.0d-2
p_region=1.0d-3
/

&AMR_PARAMS
levelmin=5
levelmax=5
ngridmax=50000
npartmax=5000
nsinkmax=4
boxlen=1.0
/

&OUTPUT_PARAMS
! Initial checkpoint only after the runner materializes its output schedule.
noutput=1
aout=1.1
tout=1.0d100
foutput=100000
fbackup=100000
tend=1.0d100
/

&HYDRO_PARAMS
gamma=1.6666666666666667d0
courant_factor=0.8d0
riemann='hllc'
pressure_fix=.true.
/

&REFINE_PARAMS
sink_refine=.false.
jeans_refine=4
m_refine=8
/

&POISSON_PARAMS
gravity_type=0
abort_on_mg_nonconvergence=.true.
maxiter_fine=1000
/

&PHYSICS_PARAMS
units_density=1.66d-24
! With units_density=1.66e-24, this makes G_code=G_cgs*rho_unit*t_unit^2=1.
units_time=3.004298591324383d15
units_length=3.085677581282d21
cooling=.false.
metal=.false.
self_shielding=.false.
smbh=.true.
agn=.false.
bondi=.false.
spin_bh=.false.
vrel_merge=.true.
rmerge=1.0d0
smbh_capture_ledger=.true.
smbh_capture_ledger_file='capture.jsonl'
yieldtablefilename='legacy_yields.dat'
n_star=1.0d99
/

&SINK_PARAMS
smbh=.true.
agn=.false.
create_sinks=.false.
accretion_scheme='none'
nsinkmax=4
nlevelmax_sink=5
mass_sink_seed=1.0d5
mass_sink_direct_force=1.0d5
/

&STELLAR_ENRICHMENT_PARAMS
! Required by this build; no stars are formed in the bounded smoke.
feedback_mode='legacy'
/
