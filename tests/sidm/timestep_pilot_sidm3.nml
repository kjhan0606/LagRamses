&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
rt=.false.
sidm=.true.
use_adm=.false.
use_fdm=.false.
use_pbh=.false.
nrestart=5
nstepmax=858
nremap=0
nsubcycle=1,1,9*2
ncontrol=1
ordering='hilbert'
memory_balance=.false.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
aout=1.1
tout=1.0d100
foutput=1000000000
fbackup=1000000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_008'
initfile(2)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_009'
initfile(3)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_010'
initfile(4)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_011'
/

&AMR_PARAMS
levelmin=8
levelmax=17
nexpand=3,3,9*1
ngridtot=240000000
nparttot=200000000
/

&REFINE_PARAMS
m_refine=11*8.
ivar_refine=0
mass_cut_refine=2.3283064365d-10
interpol_var=1
interpol_type=0
q_refine_holdback=.true.
/

&POISSON_PARAMS
epsilon=1.0d-4
maxiter_fine=80
abort_on_mg_nonconvergence=.true.
restart_phi_warm_start=.false.
/

&SIDM_PARAMS
sidm_cross_section=3.0
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_estimator_diagnostics=.true.
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/
