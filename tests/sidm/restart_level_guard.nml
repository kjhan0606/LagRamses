&RUN_PARAMS
cosmo=.false.
static=.false.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.true.
nrestart=1
nremap=0
nstepmax=1
nsubcycle=8*1
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.false.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
tout=1.0d10
foutput=1000000
/

&INIT_PARAMS
filetype='ascii'
/

&AMR_PARAMS
levelmin=3
levelmax=3
nexpand=5*0
ngridmax=200000
npartmax=10000
boxlen=1.0
/

&REFINE_PARAMS
m_refine=5*0.
mass_sph=1.0d-7
ivar_refine=-1
r_refine=5*0.25
x_refine=5*0.4375
y_refine=5*0.4375
z_refine=5*0.4375
exp_refine=5*10.
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&PHYSICS_PARAMS
units_density=1.0d-24
units_time=3.15576d13
units_length=3.08567758d21
/

&SIDM_PARAMS
sidm_cross_section=1.0d-3
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_estimator_diagnostics=.true.
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/
