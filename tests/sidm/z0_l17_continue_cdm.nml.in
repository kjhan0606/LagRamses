&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
nrestart=__NRESTART__
nremap=0
nsubcycle=1,1,9*2
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=5
aout=0.33333,0.50000,0.66667,0.80000,1.00000
foutput=500
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_008'
initfile(2)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_009'
initfile(3)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_010'
initfile(4)='/gpfs/kjhan/Hydro/Sidm/Agn/Zoom0/zoom_l11/ic_zoom_l11/level_011'
/

&AMR_PARAMS
levelmin=8
levelmax=17
nexpand=3,3,9*1
ngridtot=160000000
nparttot=100000000
/

&REFINE_PARAMS
m_refine=11*8.
ivar_refine=0
mass_cut_refine=2.3283064365d-10
interpol_var=1
interpol_type=0
q_refine_holdback=.true.
/

&POISSON_PARAMS
/
