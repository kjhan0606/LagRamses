&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
use_fdm=.true.
use_fftw=.true.
memory_balance=.false.
ordering='hilbert'
nrestart=0
ncontrol=1
nstepmax=2
nremap=1000000
nsubcycle=1,1,1,1,1,1,1,1,1
jobcontrolfile='jobcontrol.txt'
/

&FDM_PARAMS
m_axion=1.0d-22
fdm_courant=0.3
fdm_hybrid=.true.
fdm_use_hjm=.false.
fdm_first_wave_level=6
fdm_refine_matched=.true.
fdm_split_order=2
fdm_kinetic=1
fdm_cn_tol=1.0d-10
fdm_cost_mode=0
fdm_nrefine_dB=4
/

&AMR_PARAMS
levelmin=6
levelmax=7
nlevel_collapse=0
nexpand=1
ngridtot=4000000
nparttot=1000000
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/home/kjhan/BACKUP/FDM/ksection_zoom_test/ic_zoom/level_006'
/

&REFINE_PARAMS
m_refine=9*1.1
ivar_refine=0
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1000000
fbackup=1000000
informat='hdf5'
outformat='hdf5'
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
scheme='muscl'
slope_type=1
/

&POISSON_PARAMS
/
