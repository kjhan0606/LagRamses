! [RESIZABLE] Small deterministic CUDA/nGR block grid-major paired gate.
&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
clumpfind=.false.
sink=.false.
sinkprops=.false.
lightcone=.false.
rt=.false.
aton=.false.
verbose=.false.
debug=.false.
dump_pk=.false.
de_perturb=.false.
sidm=.false.
use_nDGP=.true.
use_fR=.false.
use_symmetron=.false.
use_dilaton=.false.
use_galileon=.false.
use_mond=.false.
use_coupled_de=.false.
use_quintessence=.false.
use_kessence=.false.
use_chaplygin=.false.
use_rvm=.false.
use_horndeski=.false.
use_ede=.false.
use_neutrino=.false.
use_sgs=.false.
use_adm=.false.
use_fdm=.false.
use_pbh=.false.
scalar_solver_strict=.true.
nrestart=0
static=.false.
nstepmax=4
ncontrol=1
nremap=0
nsubcycle=1,1
ordering='hilbert'
memory_balance=.false.
lb_grid_headroom=0.0
exchange_method='p2p'
aexp_step_limit=1.0d-4
use_fftw=.false.
mg_merged_rb=.false.
gpu_hydro=.false.
gpu_poisson=__GPU_POISSON__
gpu_fft=.false.
gpu_sink=.false.
gpu_scalar=__GPU_SCALAR__
gpu_particle=__GPU_PARTICLE__
pm_gpu_min_part=1
gpu_auto_tune=.false.
n_cuda_streams=1
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1
match_aout=.false.
outformat='original'
/

&COSMO_PARAMS
omega_m=0.3
omega_l=0.7
omega_b=0.0
h0=70.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='__IC_LEVEL__'
initfile(2)='__IC_LEVEL6__'
/

&AMR_PARAMS
levelmin=5
levelmax=6
ngridtot=40000
nparttot=131072
nexpand=0
/

&REFINE_PARAMS
m_refine=8.0,8.0
ivar_refine=0
/

&POISSON_PARAMS
epsilon=1.0d-4
maxiter_fine=100
abort_on_mg_nonconvergence=.true.
cg_levelmin=999
cic_levelmax=0
/

&NDGP_PARAMS
omega_rc=0.25
nDGP_branch=1
n_iter_nDGP=100
nDGP_eps=1.0d-4
/
