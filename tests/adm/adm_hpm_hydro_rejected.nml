! Negative namelist gate only: must abort before ICs/AMR initialization.
&RUN_PARAMS
cosmo=.false.
pic=.true.
poisson=.true.
hydro=.true.
sink=.false.
sidm=.true.
use_adm=.true.
nrestart=0
nstepmax=0
nsubcycle=1
nremap=0
use_fftw=.true.
/
&OUTPUT_PARAMS
noutput=1
aout=1.1
tout=1.0d100
foutput=1000000000
fbackup=1000000000
outformat='hdf5'
/
&AMR_PARAMS
levelmin=3
levelmax=3
ngridmax=2000
npartmax=2000
boxlen=1.0
/
&SIDM_PARAMS
sidm_cross_section=1.0d0
sidm_npart_min=2
sidm_type='constant'
sidm_angular='isotropic'
/
&ADM_PARAMS
adm_alpha=0.01d0
adm_mp=40.0d0
adm_me_ratio=1.0d-6
adm_xi=0.5d0
adm_T_init=1000.0d0
adm_T_floor=1.0d0
adm_hpm=.true.
adm_hpm_gamma=1.6666666666666667d0
adm_hpm_courant=0.25d0
adm_mol=.false.
/
