&RUN_PARAMS
cosmo=.false.
static=.false.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.true.
use_adm=.true.
nrestart=0
nremap=0
nstepmax=2
nsubcycle=1
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.false.
verbose=.true.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
tout=1.0d10
foutput=1
outformat='hdf5'
/

&INIT_PARAMS
filetype='ascii'
initfile(1)='__IC_DIRECTORY__'
/

&AMR_PARAMS
levelmin=3
levelmax=3
nexpand=1*0
ngridmax=2000
npartmax=2000
boxlen=1.0
/

&PHYSICS_PARAMS
units_density=1.0d-24
units_time=5.0d9
units_length=3.08567758d21
/

&SIDM_PARAMS
sidm_cross_section=1.0d-20
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/

&ADM_PARAMS
adm_alpha=1.0d-2
adm_mp=40.0d0
adm_me_ratio=1.0d-6
adm_xi=0.5d0
adm_T_init=1.0d10
adm_T_floor=1.0d-6
adm_adiabatic=.false.
adm_hpm=__ADM_HPM__
adm_hpm_gamma=1.6666666666666667d0
adm_hpm_courant=0.25d0
adm_mol=.false.
/
