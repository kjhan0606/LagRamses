&RUN_PARAMS
cosmo=.false.
static=.false.
pic=.true.
poisson=.true.
hydro=.false.
sink=.false.
sidm=.true.
use_adm=.true.
nrestart=__NRESTART__
nremap=0
nstepmax=__NSTEPMAX__
nsubcycle=8*1
ncontrol=1
ordering='hilbert'
memory_balance=.true.
use_fftw=.false.
jobcontrolfile='jobcontrol.txt'
/

&OUTPUT_PARAMS
noutput=1
tout=1.0d10
foutput=1
informat='__INFORMAT__'
outformat='hdf5'
/

&INIT_PARAMS
filetype='ascii'
initfile(1)='__IC_DIRECTORY__'
/

&AMR_PARAMS
levelmin=3
levelmax=7
nexpand=5*0
ngridmax=200000
npartmax=200000
boxlen=1.0
/

&REFINE_PARAMS
m_refine=5*0.
mass_sph=1.0d-7
ivar_refine=-1
r_refine=5*0.25
x_refine=5*0.4375
y_refine=5*0.4375
z_refine=5*0.4375
exp_refine=5*10.
interpol_var=1
interpol_type=0
q_refine_holdback=.false.
/

&PHYSICS_PARAMS
units_density=1.0d-24
units_time=5.0d9
units_length=3.08567758d21
/

&SIDM_PARAMS
sidm_cross_section=1.0d-12
sidm_npart_min=2
sidm_type='constant'
sidm_courant=0.1
sidm_angular='isotropic'
sidm_vrel_max=3.0d9
/

&ADM_PARAMS
adm_alpha=1.0d-2
adm_mp=40.0d0
adm_me_ratio=1.0d-6
adm_xi=0.5d0
adm_T_init=1.0d3
adm_mol=.false.
/
