\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Growth validation on a $15\,h^{-1}$Mpc, $256^3$ grid with $m_a=10^{-23}$\,eV. Solid curves: measured $|\psi |^2$ power spectra; dashed: linear theory; bottom panels: measured growth relative to the $z=30$ snapshot divided by the linear-theory growth. \emph  {Left}: pure wave solver --- growth follows linear theory until the velocity-Nyquist limit ($z\simeq 9$ here, section~\ref {sec:fdm_box}) and freezes beyond it. \emph  {Right}: HJM fluid solver on the same configuration --- growth continues through $z=4$; the high-$k$ excess at late times is nonlinear growth.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:fdm_growth}{{1}{11}{Growth validation on a $15\,h^{-1}$Mpc, $256^3$ grid with $m_a=10^{-23}$\,eV. Solid curves: measured $|\psi |^2$ power spectra; dashed: linear theory; bottom panels: measured growth relative to the $z=30$ snapshot divided by the linear-theory growth. \emph {Left}: pure wave solver --- growth follows linear theory until the velocity-Nyquist limit ($z\simeq 9$ here, section~\ref {sec:fdm_box}) and freezes beyond it. \emph {Right}: HJM fluid solver on the same configuration --- growth continues through $z=4$; the high-$k$ excess at late times is nonlinear growth}{figure.1}{}}
