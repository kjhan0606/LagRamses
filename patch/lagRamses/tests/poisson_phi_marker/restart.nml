&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
static=.true.
use_fftw=.false.
nrestart=2
ncontrol=1
nstepmax=3
nremap=0
nsubcycle=20*1
/

&OUTPUT_PARAMS
noutput=1
aout=1.0
foutput=1
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='unused_on_restart'
/

&AMR_PARAMS
levelmin=6
levelmax=6
ngridtot=500000
nparttot=500000
nexpand=1
/

&REFINE_PARAMS
m_refine=20*8.0
ivar_refine=0
/

&POISSON_PARAMS
epsilon=1.d-4
/
